# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# cloudflare
.dev.vars
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# 10x-cli agent tooling (installed per-machine, not part of the project)
.claude/*
!.claude/skills/
.claude/skills/*

# except project-owned skills, which are part of the project
!.claude/skills/roadmap-issues-sync/

# the same tooling where it appears in subdirectories. The patterns above are
# anchored to the repository root (a pattern containing a slash always is), so
# nested .claude/ directories need their own rule — the plain `.claude/` this
# replaced matched at every level.
*/**/.claude/
