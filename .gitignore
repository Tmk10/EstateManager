# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# cloudflare
.dev.vars
.wrangler/

# e2e. The session file holds a real access token for whatever database the suite ran
# against, so it never gets committed; `auth.setup.ts` regenerates it on demand. The
# report, the raw results and the Playwright CLI's snapshots are all per-run scratch.
playwright/.auth/
playwright-report/
test-results/
.playwright-cli/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# 10x-cli agent tooling (installed per-machine, not part of the project)
.claude/*
!.claude/skills/
.claude/skills/*

# except project-owned skills, which are part of the project
!.claude/skills/roadmap-issues-sync/

# and except the hook configuration, which is a project quality gate rather than
# a per-machine preference — the checks that run on every edit belong to whoever
# clones the repo, not to whoever happened to configure them
!.claude/settings.json

# the same tooling where it appears in subdirectories. The patterns above are
# anchored to the repository root (a pattern containing a slash always is), so
# nested .claude/ directories need their own rule — the plain `.claude/` this
# replaced matched at every level.
*/**/.claude/
