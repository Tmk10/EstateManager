---
import AppShell from "@/components/AppShell.astro";

// The start page names the product and says what it is for (`S-08`). It still says nothing
// else: no feature cards, no second sign-in button — the topbar already carries that, so the
// page describes and admits in the same breath.
//
// What changed here on 2026-08-05 is only the paint. `S-08` recorded "the cosmic styling
// stays" as an explicit decision; the product owner reversed it, and the orbs, the star field
// and the gradient-clipped wordmark went with the rest of the starter's vocabulary.
---

<AppShell title="EstateManager">
  <div class="flex flex-col items-center py-20 text-center sm:py-28">
    <h1 class="text-foreground text-4xl font-semibold tracking-tight sm:text-5xl">EstateManager</h1>
    <p class="text-muted-foreground mt-4 max-w-xl text-lg">Twój portal do zarządzania nieruchomościami</p>
  </div>
</AppShell>
