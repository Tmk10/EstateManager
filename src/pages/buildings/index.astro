---
import AppShell from "@/components/AppShell.astro";
import { createClient } from "@/lib/supabase";
import {
  CARD,
  PAGE_TITLE,
  SECTION_TITLE,
  MUTED_TEXT,
  BUTTON_PRIMARY,
  ALERT_ERROR,
  EMPTY_STATE,
  FINE_PRINT,
} from "@/lib/ui";

// Middleware has already bounced anonymous visitors (PROTECTED_ROUTES), so reaching
// this line means there is a signed-in administrator. The client can still be null
// when SUPABASE_URL / SUPABASE_KEY are unset — those are optional: true in
// astro.config.mjs, so an unconfigured deploy renders rather than crashing.
const supabase = createClient(Astro.request.headers, Astro.cookies);

const { data: buildings, error } = supabase
  ? await supabase.from("buildings").select("id, name, city, street").order("name")
  : { data: null, error: { message: "Baza danych nie jest skonfigurowana." } };
---

<AppShell title="Budynki">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class:list={PAGE_TITLE}>Budynki</h1>
    <a href="/buildings/new" class:list={BUTTON_PRIMARY}>Dodaj budynek</a>
  </div>

  {
    error ? (
      <p class:list={ALERT_ERROR} role="alert">
        Nie udało się wczytać listy budynków: {error.message}
      </p>
    ) : buildings.length > 0 ? (
      <ul class="grid gap-3 sm:grid-cols-2">
        {buildings.map((building) => (
          <li class:list={[CARD, "hover:border-ring hover:bg-accent/40 relative p-5 transition-colors"]}>
            <h2 class:list={SECTION_TITLE}>
              <a href={`/buildings/${building.id}`} class="after:absolute after:inset-0">
                {building.name}
              </a>
            </h2>
            <p class:list={["mt-1", MUTED_TEXT]}>
              {building.street}, {building.city}
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <div class:list={EMPTY_STATE}>
        <p class="text-foreground text-sm">Nie ma jeszcze żadnego budynku.</p>
        <p class:list={["mt-1", FINE_PRINT]}>Dodaj pierwszy, żeby zacząć.</p>
      </div>
    )
  }
</AppShell>
