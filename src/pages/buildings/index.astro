---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

// Middleware has already bounced anonymous visitors (PROTECTED_ROUTES), so reaching
// this line means there is a signed-in administrator. The client can still be null
// when SUPABASE_URL / SUPABASE_KEY are unset — those are optional: true in
// astro.config.mjs, so an unconfigured deploy renders rather than crashing.
const supabase = createClient(Astro.request.headers, Astro.cookies);

const { data: buildings, error } = supabase
  ? await supabase.from("buildings").select("id, name, city, street").order("name")
  : { data: null, error: { message: "Baza danych nie jest skonfigurowana." } };
---

<Layout title="Budynki">
  <div class="bg-cosmic min-h-screen p-4 py-12">
    <div
      class="mx-auto w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl"
    >
      <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Budynki
        </h1>
        <a
          href="/buildings/new"
          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium transition-colors hover:bg-purple-500"
        >
          Dodaj budynek
        </a>
      </div>

      {
        error ? (
          <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300" role="alert">
            Nie udało się wczytać listy budynków: {error.message}
          </p>
        ) : buildings.length > 0 ? (
          <ul class="space-y-3">
            {buildings.map((building) => (
              <li>
                <a
                  href={`/buildings/${building.id}`}
                  class="block rounded-xl border border-white/10 bg-white/5 px-4 py-3 transition-colors hover:border-purple-400/40 hover:bg-white/10"
                >
                  <p class="font-medium">{building.name}</p>
                  <p class="mt-1 text-sm text-blue-100/60">
                    {building.street}, {building.city}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="rounded-xl border border-dashed border-white/10 bg-white/5 px-4 py-10 text-center">
            <p class="text-blue-100/80">Nie ma jeszcze żadnego budynku.</p>
            <p class="mt-1 text-sm text-blue-100/50">Dodaj pierwszy, żeby zacząć.</p>
          </div>
        )
      }

      <p class="mt-8 text-center text-sm">
        <a
          href="/dashboard"
          class="text-blue-200/80 underline-offset-4 transition-colors hover:text-white hover:underline"
        >
          Wróć do panelu
        </a>
      </p>
    </div>
  </div>
</Layout>
