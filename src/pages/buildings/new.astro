---
import AppShell from "@/components/AppShell.astro";
import BuildingForm from "@/components/buildings/BuildingForm";
import { CARD_PADDED, PAGE_TITLE, MUTED_TEXT, NAV_LINK } from "@/lib/ui";

// The endpoint redirects back here with ?error=<message> rather than returning a JSON
// body — the shape every form endpoint in this app uses.
const error = Astro.url.searchParams.get("error");
---

<AppShell title="Nowy budynek" width="narrow">
  <div class:list={CARD_PADDED}>
    <h1 class:list={PAGE_TITLE}>Nowy budynek</h1>
    <p class:list={["mt-1 mb-6", MUTED_TEXT]}>Podaj nazwę wspólnoty oraz jej adres.</p>

    <BuildingForm serverError={error} client:load />
  </div>

  <p class="mt-6 text-center text-sm">
    <a href="/buildings" class:list={NAV_LINK}>Wróć do listy budynków</a>
  </p>
</AppShell>
