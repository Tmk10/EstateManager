---
import AppShell from "@/components/AppShell.astro";
import BuildingHeader from "@/components/buildings/BuildingHeader.astro";
import { createClient } from "@/lib/supabase";
import { formatShareBps, formatSquareMetres, TOTAL_BPS } from "@/lib/shares";
import {
  SECTION_TITLE,
  MUTED_TEXT,
  FINE_PRINT,
  BUTTON_PRIMARY,
  ALERT_ERROR,
  EMPTY_STATE,
  TABLE_WRAP,
  TABLE,
  TABLE_HEAD,
  TABLE_BODY,
  TABLE_ROW,
  TABLE_FOOT,
  TH,
  TH_NUMERIC,
  TD,
  TD_NUMERIC,
} from "@/lib/ui";

// The base module of a building (roadmap `S-09`, level 2): lokale and their właściciele. This
// table lived on `/buildings/<id>` until the building page became the index of its modules.
// Behaviour moved with it unchanged — the collation-aware sort, the totals row and the alarm
// below all predate this route.

const { id } = Astro.params;

// The client can be null when SUPABASE_URL / SUPABASE_KEY are unset — those are optional: true
// in astro.config.mjs.
const supabase = createClient(Astro.request.headers, Astro.cookies);

const error = Astro.url.searchParams.get("error");

let loadError: string | null = null;
let building: { id: string; name: string; city: string; street: string; total_area_m2: number | null } | null = null;
let units: {
  id: string;
  unit_number: string;
  area_m2: number;
  share_bps: number;
  full_name: string;
  email: string | null;
}[] = [];

if (!supabase) {
  loadError = "Baza danych nie jest skonfigurowana.";
} else if (!id) {
  loadError = "Nie znaleziono budynku.";
} else {
  const { data, error: buildingError } = await supabase
    .from("buildings")
    .select("id, name, city, street, total_area_m2")
    .eq("id", id)
    .maybeSingle();

  if (buildingError) {
    // 22P02 is invalid_text_representation — the id in the URL is not a uuid at all, which is a
    // wrong address rather than a database problem.
    loadError = buildingError.code === "22P02" ? "Nie znaleziono budynku." : buildingError.message;
  } else if (!data) {
    loadError = "Nie znaleziono budynku.";
  } else {
    building = data;

    const { data: unitRows, error: unitsError } = await supabase
      .from("units")
      .select("id, unit_number, area_m2, share_bps, owners(full_name, email)")
      .eq("building_id", id);

    if (unitsError) {
      loadError = unitsError.message;
    } else {
      units = unitRows.map((row) => ({
        id: row.id,
        unit_number: row.unit_number,
        area_m2: row.area_m2,
        share_bps: row.share_bps,
        full_name: row.owners.full_name,
        email: row.owners.email,
      }));

      // Sorted here rather than in the query because unit numbers are text: ordering them
      // in SQL puts "10" between "1" and "2", which is visibly wrong to anyone reading
      // their own registry. Numeric-aware collation gives 1, 2, ... 10 while still
      // handling "3A" and "12/1".
      units.sort((a, b) => a.unit_number.localeCompare(b.unit_number, "pl", { numeric: true }));
    }
  }
}

const shareTotal = units.reduce((sum, unit) => sum + unit.share_bps, 0);
---

<AppShell title={building ? `Rejestr lokali — ${building.name}` : "Rejestr lokali"} width="wide">
  {
    loadError ? (
      <p class:list={ALERT_ERROR} role="alert">
        {loadError}
      </p>
    ) : (
      building && (
        <>
          <BuildingHeader building={building} activeModule="units" />

          {error && (
            <p class:list={[ALERT_ERROR, "mb-6"]} role="alert">
              {error}
            </p>
          )}

          {units.length > 0 ? (
            <>
              <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
                <h2 class:list={SECTION_TITLE}>Rejestr lokali</h2>
                <p class:list={MUTED_TEXT}>
                  Lokali: <span class="text-foreground font-medium">{units.length}</span>
                  {building.total_area_m2 !== null && (
                    <>
                      {" · "}Łączna powierzchnia:{" "}
                      <span class="text-foreground font-medium">{formatSquareMetres(building.total_area_m2)} m²</span>
                    </>
                  )}
                </p>
              </div>

              <div class:list={TABLE_WRAP}>
                <table class:list={TABLE}>
                  <thead class:list={TABLE_HEAD}>
                    <tr>
                      <th scope="col" class:list={TH}>
                        Nr lokalu
                      </th>
                      <th scope="col" class:list={TH_NUMERIC}>
                        Metraż
                      </th>
                      <th scope="col" class:list={TH_NUMERIC}>
                        Udział
                      </th>
                      <th scope="col" class:list={TH}>
                        Właściciel
                      </th>
                      <th scope="col" class:list={TH}>
                        E-mail
                      </th>
                    </tr>
                  </thead>
                  <tbody class:list={TABLE_BODY}>
                    {units.map((unit) => (
                      <tr class:list={TABLE_ROW}>
                        <td class:list={[TD, "font-medium"]}>{unit.unit_number}</td>
                        <td class:list={TD_NUMERIC}>{formatSquareMetres(unit.area_m2)} m²</td>
                        <td class:list={TD_NUMERIC}>{formatShareBps(unit.share_bps)}</td>
                        <td class:list={TD}>{unit.full_name}</td>
                        <td class:list={TD}>{unit.email ?? <span class="text-muted-foreground">brak</span>}</td>
                      </tr>
                    ))}
                  </tbody>
                  <tfoot class:list={TABLE_FOOT}>
                    <tr>
                      <td class:list={TD}>Razem</td>
                      <td class:list={TD_NUMERIC}>
                        {building.total_area_m2 !== null && `${formatSquareMetres(building.total_area_m2)} m²`}
                      </td>
                      <td class:list={TD_NUMERIC}>{formatShareBps(shareTotal)}</td>
                      <td class:list={TD} colspan="2" />
                    </tr>
                  </tfoot>
                </table>
              </div>

              {shareTotal !== TOTAL_BPS && (
                <p class:list={[ALERT_ERROR, "mt-4"]} role="alert">
                  Suma udziałów wynosi {formatShareBps(shareTotal)} zamiast 100,00%. Zgłoś to jako błąd.
                </p>
              )}
            </>
          ) : (
            <div class:list={EMPTY_STATE}>
              <p class="text-foreground text-sm">Ten budynek nie ma jeszcze rejestru lokali.</p>
              <p class:list={["mt-1", FINE_PRINT]}>
                Wczytaj listę lokali z pliku CSV, żeby policzyć udziały właścicieli.
              </p>
              <a href={`/buildings/${building.id}/units/import`} class:list={[BUTTON_PRIMARY, "mt-5"]}>
                Wczytaj lokale z pliku CSV
              </a>
            </div>
          )}
        </>
      )
    )
  }
</AppShell>
