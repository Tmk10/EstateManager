---
import AppShell from "@/components/AppShell.astro";
import UnitsUploadForm from "@/components/buildings/UnitsUploadForm";
import { createClient } from "@/lib/supabase";
import { CSV_HEADERS, parseUnitsCsv, type ParseError } from "@/lib/units-csv";
import { computeShareBps, formatAreaHundredths, formatShareBps, TOTAL_BPS } from "@/lib/shares";
import {
  CARD_PADDED,
  PANEL,
  PAGE_TITLE,
  MUTED_TEXT,
  FINE_PRINT,
  SUBSECTION_TITLE,
  BUTTON_PRIMARY,
  BUTTON_PRIMARY_BLOCK,
  BUTTON_SECONDARY,
  ALERT,
  ALERT_ERROR,
  ALERT_TONES,
  EMPTY_STATE,
  NAV_LINK,
  TABLE_WRAP,
  TABLE,
  TABLE_HEAD,
  TABLE_BODY,
  TABLE_ROW,
  TABLE_FOOT,
  TH,
  TH_NUMERIC,
  TD,
  TD_NUMERIC,
} from "@/lib/ui";

const { id } = Astro.params;

// One page, two states — upload, then preview — using Astro's documented form-handling
// recipe (Astro.request.method === "POST" plus Astro.request.formData()) rather than a
// second route. The confirm step is the only thing that needs an API endpoint, because it
// is the only thing that writes.
const supabase = createClient(Astro.request.headers, Astro.cookies);

// A file this big is not a unit registry. 1000 rows of four short fields is well under
// 100 kB; the limit is here so a mis-selected file is rejected before it is decoded.
const MAX_FILE_BYTES = 1024 * 1024;

// What browsers actually send for a .csv: text/csv on macOS, application/vnd.ms-excel on
// a machine with Excel installed, text/plain from some editors, and occasionally nothing
// at all.
const ACCEPTED_TYPES = ["text/csv", "application/vnd.ms-excel", "text/plain", ""];

interface PreviewRow {
  unitNumber: string;
  areaLabel: string;
  shareLabel: string;
  fullName: string;
  email: string | null;
}

let loadError: string | null = null;
let building: { id: string; name: string; city: string; street: string } | null = null;
let alreadyImported = false;

let uploadError: string | null = Astro.url.searchParams.get("error");
let parseErrors: ParseError[] = [];
let previewRows: PreviewRow[] = [];
let previewCsv = "";
let previewAreaLabel = "";

if (!supabase) {
  loadError = "Baza danych nie jest skonfigurowana.";
} else if (!id) {
  loadError = "Nie znaleziono budynku.";
} else {
  const { data, error: buildingError } = await supabase
    .from("buildings")
    .select("id, name, city, street")
    .eq("id", id)
    .maybeSingle();

  if (buildingError) {
    loadError = buildingError.code === "22P02" ? "Nie znaleziono budynku." : buildingError.message;
  } else if (!data) {
    loadError = "Nie znaleziono budynku.";
  } else {
    building = data;

    // Checked before a file is chosen, not after: re-import is refused by the database
    // anyway (EM002), but learning that after picking a file and waiting for a preview is
    // a worse way to find out.
    const { count, error: countError } = await supabase
      .from("units")
      .select("id", { count: "exact", head: true })
      .eq("building_id", id);

    if (countError) {
      loadError = countError.message;
    } else {
      alreadyImported = (count ?? 0) > 0;
    }
  }
}

if (Astro.request.method === "POST" && building && !alreadyImported) {
  const form = await Astro.request.formData();
  const file = form.get("file");

  if (!(file instanceof File) || file.size === 0) {
    uploadError = "Wybierz plik CSV z listą lokali.";
  } else if (file.size > MAX_FILE_BYTES) {
    uploadError = "Plik jest za duży — maksymalny rozmiar to 1 MB.";
  } else if (!ACCEPTED_TYPES.includes(file.type.split(";")[0].trim().toLowerCase())) {
    uploadError = "To nie jest plik CSV. Zapisz arkusz jako CSV i spróbuj ponownie.";
  } else {
    const bytes = new Uint8Array(await file.arrayBuffer());
    const parsed = parseUnitsCsv(bytes);

    if (!parsed.ok) {
      parseErrors = parsed.errors;
    } else {
      const shareBps = computeShareBps(parsed.rows.map((row) => row.areaHundredths));

      if (!Array.isArray(shareBps)) {
        uploadError = shareBps.error;
      } else {
        previewRows = parsed.rows.map((row, index) => ({
          unitNumber: row.unitNumber,
          areaLabel: formatAreaHundredths(row.areaHundredths),
          shareLabel: formatShareBps(shareBps[index]),
          fullName: row.fullName,
          email: row.email,
        }));

        const totalHundredths = parsed.rows.reduce((sum, row) => sum + row.areaHundredths, 0);
        previewAreaLabel = formatAreaHundredths(totalHundredths);

        // The preview carries the original CSV text, not the computed shares. The confirm
        // endpoint re-parses and recomputes from exactly these bytes; a decode here is
        // safe because the parser has already accepted them as UTF-8. TextDecoder drops
        // the BOM by default, and the parser strips one anyway, so the round trip is
        // byte-stable either way.
        previewCsv = new TextDecoder("utf-8").decode(bytes);
      }
    }
  }
}

const showPreview = previewRows.length > 0;
---

<AppShell title="Wczytaj lokale" width={showPreview ? "wide" : "default"}>
  {
    loadError ? (
      <p class:list={ALERT_ERROR} role="alert">
        {loadError}
      </p>
    ) : (
      building && (
        <>
          <div class="mb-6">
            <h1 class:list={PAGE_TITLE}>Wczytaj lokale</h1>
            <p class:list={["mt-1", MUTED_TEXT]}>
              {building.name} — {building.street}, {building.city}
            </p>
          </div>

          {alreadyImported ? (
            <div class:list={EMPTY_STATE}>
              <p class="text-foreground text-sm">Ten budynek ma już zaimportowany rejestr lokali.</p>
              <p class:list={["mt-1", FINE_PRINT]}>
                Rejestru nie da się wczytać drugi raz — zmiana udziałów w trakcie głosowania przesunęłaby próg
                większości.
              </p>
              <a href={`/buildings/${building.id}/units`} class:list={[BUTTON_PRIMARY, "mt-5"]}>
                Zobacz rejestr lokali
              </a>
            </div>
          ) : showPreview ? (
            <>
              <p class:list={["mb-4", MUTED_TEXT]}>
                Sprawdź dane przed zapisaniem. Udziały zostały wyliczone z metraży — po zapisaniu rejestru nie da się
                ich zmienić.
              </p>

              <div class:list={TABLE_WRAP}>
                <table class:list={TABLE}>
                  <thead class:list={TABLE_HEAD}>
                    <tr>
                      <th scope="col" class:list={TH}>
                        Nr lokalu
                      </th>
                      <th scope="col" class:list={TH_NUMERIC}>
                        Metraż
                      </th>
                      <th scope="col" class:list={TH_NUMERIC}>
                        Udział
                      </th>
                      <th scope="col" class:list={TH}>
                        Właściciel
                      </th>
                      <th scope="col" class:list={TH}>
                        E-mail
                      </th>
                    </tr>
                  </thead>
                  <tbody class:list={TABLE_BODY}>
                    {previewRows.map((row) => (
                      <tr class:list={TABLE_ROW}>
                        <td class:list={[TD, "font-medium"]}>{row.unitNumber}</td>
                        <td class:list={TD_NUMERIC}>{row.areaLabel} m²</td>
                        <td class:list={TD_NUMERIC}>{row.shareLabel}</td>
                        <td class:list={TD}>{row.fullName}</td>
                        <td class:list={TD}>{row.email ?? <span class="text-muted-foreground">brak</span>}</td>
                      </tr>
                    ))}
                  </tbody>
                  <tfoot class:list={TABLE_FOOT}>
                    <tr>
                      <td class:list={TD}>Razem ({previewRows.length})</td>
                      <td class:list={TD_NUMERIC}>{previewAreaLabel} m²</td>
                      <td class:list={TD_NUMERIC}>{formatShareBps(TOTAL_BPS)}</td>
                      <td class:list={TD} colspan="2" />
                    </tr>
                  </tfoot>
                </table>
              </div>

              <form method="POST" action={`/api/buildings/${building.id}/units`} class="mt-6">
                <input type="hidden" name="csv" value={previewCsv} />
                <button type="submit" class:list={BUTTON_PRIMARY_BLOCK}>
                  Zapisz rejestr lokali
                </button>
              </form>

              <p class="mt-3 text-center text-sm">
                <a href={`/buildings/${building.id}/units/import`} class:list={NAV_LINK}>
                  Wybierz inny plik
                </a>
              </p>
            </>
          ) : (
            <div class:list={CARD_PADDED}>
              {parseErrors.length > 0 && (
                <div class:list={[ALERT, ALERT_TONES.error, "mb-6"]} role="alert">
                  <p class="font-medium">
                    Plik nie został wczytany. Popraw {parseErrors.length === 1 ? "poniższy błąd" : "poniższe błędy"} i
                    spróbuj ponownie:
                  </p>
                  <ul class="mt-3 space-y-1.5">
                    {parseErrors.map((parseError) => (
                      <li>
                        <span class="font-medium">Wiersz {parseError.line}:</span> {parseError.message}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class:list={[PANEL, "mb-6"]}>
                <p class:list={SUBSECTION_TITLE}>Plik musi mieć cztery kolumny:</p>
                <ul class="text-muted-foreground mt-2 space-y-1 text-sm">
                  <li>
                    <code class="bg-card text-foreground rounded px-1 py-0.5 font-mono text-xs">{CSV_HEADERS[0]}</code>{" "}
                    — numer lokalu, np. 12 albo 3A
                  </li>
                  <li>
                    <code class="bg-card text-foreground rounded px-1 py-0.5 font-mono text-xs">{CSV_HEADERS[1]}</code>{" "}
                    — powierzchnia w m², przecinek dziesiętny, np. 52,40
                  </li>
                  <li>
                    <code class="bg-card text-foreground rounded px-1 py-0.5 font-mono text-xs">{CSV_HEADERS[2]}</code>{" "}
                    — imię i nazwisko właściciela
                  </li>
                  <li>
                    <code class="bg-card text-foreground rounded px-1 py-0.5 font-mono text-xs">{CSV_HEADERS[3]}</code>{" "}
                    — adres e-mail, może zostać pusty
                  </li>
                </ul>
                <p class:list={["mt-3", MUTED_TEXT]}>
                  Wiersze z tym samym adresem e-mail trafią do jednego właściciela. Udziały wyliczymy z metraży.
                </p>
                <a href="/api/buildings/units-template.csv" class:list={[BUTTON_SECONDARY, "mt-4"]}>
                  Pobierz pusty szablon CSV
                </a>
              </div>

              <UnitsUploadForm serverError={uploadError} client:load />
            </div>
          )}
        </>
      )
    )
  }

  <p class="mt-6 text-center text-sm">
    <a href={building ? `/buildings/${building.id}/units` : "/buildings"} class:list={NAV_LINK}
      >Wróć do rejestru lokali</a
    >
  </p>
</AppShell>
