---
import AppShell from "@/components/AppShell.astro";
import BuildingHeader from "@/components/buildings/BuildingHeader.astro";
import { createClient } from "@/lib/supabase";
import { formatShareBps, formatSquareMetres } from "@/lib/shares";
import { BUILDING_MODULES, buildingModuleHref } from "@/lib/building-modules";
import {
  CARD_PADDED,
  SECTION_TITLE,
  SUBSECTION_TITLE,
  MUTED_TEXT,
  BUTTON_PRIMARY,
  ALERT_ERROR,
  FINE_PRINT,
  LINK,
} from "@/lib/ui";

// The state of this building, module by module (roadmap `S-09`, level 2). This page used to *be*
// the registry; the registry now lives at `/buildings/<id>/units` and the resolutions list at
// `/buildings/<id>/resolutions`.
//
// It also used to be the *menu* of those two modules — one tile each, in the middle of the
// screen. The menu moved to the rail on the left on 2026-08-05 (`src/components/SideNav.astro`),
// on the product owner's instruction, and what is left here is what the tiles carried besides
// navigation: how far each module has got, and the one thing to do next when it has not started.
// The loop over BUILDING_MODULES stayed, and stayed for the same reason — a module added to the
// registry appears here without this file being edited.
//
// Both new routes are already behind the auth gate: PROTECTED_ROUTES in src/middleware.ts
// matches with startsWith and contains "/buildings". No entry was added — verified by request,
// not by reading the array, because an unprotected page looks exactly like a protected one.

const { id } = Astro.params;

// The client can be null when SUPABASE_URL / SUPABASE_KEY are unset — those are optional: true
// in astro.config.mjs.
const supabase = createClient(Astro.request.headers, Astro.cookies);

const error = Astro.url.searchParams.get("error");

let loadError: string | null = null;
let building: { id: string; name: string; city: string; street: string; total_area_m2: number | null } | null = null;
let unitCount = 0;
let shareTotal = 0;
let resolutionCount = 0;
let openResolutionCount = 0;

if (!supabase) {
  loadError = "Baza danych nie jest skonfigurowana.";
} else if (!id) {
  loadError = "Nie znaleziono budynku.";
} else {
  const { data, error: buildingError } = await supabase
    .from("buildings")
    .select("id, name, city, street, total_area_m2")
    .eq("id", id)
    .maybeSingle();

  if (buildingError) {
    // 22P02 is invalid_text_representation — the id in the URL is not a uuid at all, which is a
    // wrong address rather than a database problem.
    loadError = buildingError.code === "22P02" ? "Nie znaleziono budynku." : buildingError.message;
  } else if (!data) {
    loadError = "Nie znaleziono budynku.";
  } else {
    building = data;

    // Only what the two cards state. The rows themselves belong to the modules — this page has
    // no table to fill.
    const { data: unitRows, error: unitsError } = await supabase
      .from("units")
      .select("id, share_bps")
      .eq("building_id", id);

    if (unitsError) {
      loadError = unitsError.message;
    } else {
      unitCount = unitRows.length;
      shareTotal = unitRows.reduce((sum, unit) => sum + unit.share_bps, 0);

      const { data: resolutionRows, error: resolutionsError } = await supabase
        .from("resolutions")
        .select("id, status")
        .eq("building_id", id);

      if (resolutionsError) {
        loadError = resolutionsError.message;
      } else {
        resolutionCount = resolutionRows.length;
        openResolutionCount = resolutionRows.filter((row) => row.status === "open").length;
      }
    }
  }
}

// Per-module state, keyed by the registry's ids. A module with no entry here still renders — its
// card falls back to label, description and the link — so adding a module stays an entry in
// BUILDING_MODULES rather than an edit to the markup below.
const summaries: Record<string, string | undefined> = {};
const notices: Record<string, { message: string; ctaLabel: string; ctaHref: string } | undefined> = {};

if (building) {
  if (unitCount > 0) {
    const parts = [`Lokali: ${String(unitCount)}`];
    if (building.total_area_m2 !== null) {
      parts.push(`${formatSquareMetres(building.total_area_m2)} m²`);
    }
    parts.push(formatShareBps(shareTotal));
    summaries.units = parts.join(" · ");
  } else {
    notices.units = {
      message: "Bez rejestru nie da się policzyć udziałów.",
      ctaLabel: "Wczytaj lokale z pliku CSV",
      ctaHref: `/buildings/${building.id}/units/import`,
    };
  }

  if (unitCount === 0) {
    // The voting module is listed even with an empty registry — it exists whether or not it has
    // content, and hiding it hid the product's own structure. It only says what comes first.
    notices.resolutions = {
      message: "Najpierw rejestr lokali — bez niego nie wiadomo, komu wystawić link do głosowania.",
      ctaLabel: "Wczytaj lokale z pliku CSV",
      ctaHref: `/buildings/${building.id}/units/import`,
    };
  } else if (resolutionCount === 0) {
    notices.resolutions = {
      message: "Ten budynek nie ma jeszcze żadnej uchwały.",
      ctaLabel: "Nowa uchwała",
      ctaHref: `/buildings/${building.id}/resolutions/new`,
    };
  } else {
    summaries.resolutions =
      openResolutionCount > 0
        ? `Uchwał: ${String(resolutionCount)} · otwartych głosowań: ${String(openResolutionCount)}`
        : `Uchwał: ${String(resolutionCount)}`;
  }
}
---

<AppShell title={building ? building.name : "Budynek"}>
  {
    loadError ? (
      <p class:list={ALERT_ERROR} role="alert">
        {loadError}
      </p>
    ) : (
      building && (
        <>
          <BuildingHeader building={building} />

          {error && (
            <p class:list={[ALERT_ERROR, "mb-6"]} role="alert">
              {error}
            </p>
          )}

          <section class:list={CARD_PADDED}>
            <h2 class:list={SECTION_TITLE}>Stan budynku</h2>
            <p class:list={["mt-1", MUTED_TEXT]}>Moduły tego budynku otwierasz z menu po lewej stronie.</p>

            <ul class="divide-border mt-4 divide-y">
              {BUILDING_MODULES.map((module) => {
                const summary = summaries[module.id];
                const notice = notices[module.id];
                return (
                  <li class="flex flex-col py-4 first:pt-0 last:pb-0">
                    <h3 class:list={SUBSECTION_TITLE}>
                      <a href={buildingModuleHref(building.id, module)} class:list={LINK}>
                        {module.label}
                      </a>
                    </h3>
                    <p class:list={["mt-0.5", FINE_PRINT]}>{module.description}</p>

                    {summary && <p class="text-foreground mt-2 text-sm font-medium tabular-nums">{summary}</p>}

                    {notice && (
                      <>
                        <p class:list={["mt-2", MUTED_TEXT]}>{notice.message}</p>
                        <a href={notice.ctaHref} class:list={[BUTTON_PRIMARY, "mt-3 self-start"]}>
                          {notice.ctaLabel}
                        </a>
                      </>
                    )}
                  </li>
                );
              })}
            </ul>
          </section>
        </>
      )
    )
  }
</AppShell>
