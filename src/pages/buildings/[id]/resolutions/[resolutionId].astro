---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { formatShareBps } from "@/lib/shares";
import { formatResolutionDate, describeResolutionStatus } from "@/lib/resolutions";
// Safe to import here precisely because it is dependency-free: it does NOT import
// src/lib/email.ts, which would pull `cloudflare:workers` into this component's graph.
import { describeSendFailure } from "@/lib/voting-link-email";

const { id, resolutionId } = Astro.params;

// Middleware has already bounced anonymous visitors (PROTECTED_ROUTES covers "/buildings").
const supabase = createClient(Astro.request.headers, Astro.cookies);

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");

/**
 * The fanout's run summary, counts only -- it never carries a token, an address or a name.
 * Read as numbers rather than echoed as text so that nothing from the query string reaches
 * the page as prose.
 */
const parseCount = (name: string): number => {
  const raw = Astro.url.searchParams.get(name);
  if (raw === null) return 0;
  const value = Number.parseInt(raw, 10);
  return Number.isFinite(value) && value >= 0 ? value : 0;
};
const sentCount = parseCount("sent");
const failedCount = parseCount("failed");
const unrecordedCount = parseCount("unrecorded");
const hasRunSummary = Astro.url.searchParams.has("sent");

interface OwnerRow {
  id: string;
  fullName: string;
  email: string | null;
  unitNumbers: string[];
  shareBps: number;
  /**
   * Whether a link exists -- never the link itself. This page reports on the state of the
   * voting links; it is not a delivery channel for them. See the read below.
   */
  hasLink: boolean;
  /**
   * Send state, derived at render time rather than stored (see the S-04 migration): a
   * `status` column would be a second thing to keep in agreement with these timestamps.
   * Null when the owner has no link at all.
   */
  send: { sentAt: string | null; lastErrorCode: string | null; attemptCount: number } | null;
}

let loadError: string | null = null;
let building: { id: string; name: string; city: string; street: string } | null = null;
let resolution: {
  id: string;
  number: string;
  title: string;
  body: string;
  status: string;
  opened_at: string | null;
} | null = null;
let ownerRows: OwnerRow[] = [];
/**
 * How many owners have voted -- a count of *people*, not of udziały. The outcome rule
 * (FR-008) counts only shares, so this number never decides anything; it exists so the
 * administrator can see votes landing before S-05 puts the share balance on this page and
 * replaces it. Deliberately a bare count: no per-owner marker, no choice, no percentage --
 * those carry the question of whether an administrator may see *how* someone voted, which
 * S-06 is scoped to answer and this slice is not.
 */
let voteCount = 0;

if (!supabase) {
  loadError = "Baza danych nie jest skonfigurowana.";
} else if (!id || !resolutionId) {
  loadError = "Nie znaleziono uchwały.";
} else {
  const { data: buildingData, error: buildingError } = await supabase
    .from("buildings")
    .select("id, name, city, street")
    .eq("id", id)
    .maybeSingle();

  if (buildingError) {
    // 22P02 is invalid_text_representation — the id in the URL is not a uuid at all.
    loadError = buildingError.code === "22P02" ? "Nie znaleziono budynku." : buildingError.message;
  } else if (!buildingData) {
    loadError = "Nie znaleziono budynku.";
  } else {
    building = buildingData;

    // Scoped by building_id as well as id: a resolution id belonging to another building is
    // "not found" here rather than a cross-building read.
    const { data: resolutionData, error: resolutionError } = await supabase
      .from("resolutions")
      .select("id, number, title, body, status, opened_at")
      .eq("id", resolutionId)
      .eq("building_id", id)
      .maybeSingle();

    if (resolutionError) {
      loadError = resolutionError.code === "22P02" ? "Nie znaleziono uchwały." : resolutionError.message;
    } else if (!resolutionData) {
      loadError = "Nie znaleziono uchwały.";
    } else {
      resolution = resolutionData;

      if (resolution.status !== "draft") {
        // Four reads joined in memory rather than one nested select. The registry is at
        // most ~70 owners and the alternative would be a projection string deep enough that
        // a wrong column in it would go unnoticed — supabase-js does not type-check the
        // contents of .select(). They go out together: the vote count is one more round
        // trip in parallel, not one more in sequence.
        const [ownersResult, unitsResult, linksResult, votesResult] = await Promise.all([
          supabase.from("owners").select("id, full_name, email").eq("building_id", id),
          supabase.from("units").select("owner_id, unit_number, share_bps").eq("building_id", id),
          // owner_id only, deliberately: the token is NOT projected here and must not be.
          // A voting token is a bearer credential -- whoever holds it can act as that owner
          // -- so the value stays in the database, and the paths that legitimately need it
          // (S-04's fanout) read it server-side and put it in an e-mail, never in a page.
          // The accompanying migration revokes column-level `select (token)` from
          // `authenticated`, so adding it back to this string fails at the database with
          // 42501 rather than quietly widening what an administrator's browser receives.
          // The send-state columns are readable here only because the S-04 migration added
          // them to the column-level grant; `token` is still absent from it and still must
          // never appear in this string.
          supabase
            .from("voting_links")
            .select("owner_id, sent_at, last_error_code, attempt_count")
            .eq("resolution_id", resolutionId),
          // head: true — the rows themselves are never wanted here. A vote row carries the
          // owner and the choice, and neither belongs on this page (see voteCount above);
          // asking only for the count means the browser cannot receive them by accident.
          // "id" rather than "*" for the same reason the links read names its column: a
          // later column-level revoke on this table would turn "*" into a 42501.
          supabase.from("votes").select("id", { count: "exact", head: true }).eq("resolution_id", resolutionId),
        ]);

        const readError = ownersResult.error ?? unitsResult.error ?? linksResult.error ?? votesResult.error;

        if (readError) {
          loadError = readError.message;
        } else {
          const linksByOwner = new Map(linksResult.data.map((link) => [link.owner_id, link]));

          ownerRows = ownersResult.data.map((owner) => {
            const units = unitsResult.data.filter((unit) => unit.owner_id === owner.id);
            const link = linksByOwner.get(owner.id);

            return {
              id: owner.id,
              fullName: owner.full_name,
              email: owner.email,
              // Numeric-aware collation, the same treatment the registry table gives unit
              // numbers: plain text ordering puts "10" between "1" and "2".
              unitNumbers: units
                .map((unit) => unit.unit_number)
                .sort((a, b) => a.localeCompare(b, "pl", { numeric: true })),
              // Per-owner voting: an owner holding several units votes once, with their
              // shares summed into a single weight (PRD, 2026-08-02).
              shareBps: units.reduce((sum, unit) => sum + unit.share_bps, 0),
              hasLink: link !== undefined,
              send:
                link === undefined
                  ? null
                  : {
                      sentAt: link.sent_at,
                      lastErrorCode: link.last_error_code,
                      attemptCount: link.attempt_count,
                    },
            };
          });

          ownerRows.sort((a, b) => a.fullName.localeCompare(b.fullName, "pl", { numeric: true }));

          // null count means PostgREST answered without one; 0 is the honest reading, and
          // it renders as "Zagłosowało 0 z N", not as a missing figure.
          voteCount = votesResult.count ?? 0;
        }
      }
    }
  }
}

// Still the gate for the edit form and the `Uruchom głosowanie` panel — those belong to the
// draft state alone, and that has not changed. What has changed is the badge: it must no
// longer read "everything that is not a draft is an open vote".
const isDraft = resolution?.status === "draft";

// The `?? "draft"` is inert: when there is no resolution the badge is not rendered at all.
// It exists so this stays one call rather than two inside the markup.
const statusBadge = describeResolutionStatus(resolution?.status ?? "draft");
const linkedOwners = ownerRows.filter((owner) => owner.hasLink);

// Two different reasons an owner has no link, split because the copy for each says
// something the administrator would act on differently. Today only the first group can be
// non-empty -- links are created for exactly the owners with an e-mail, and the open
// endpoint refuses to flip the status unless the counts agree. The second group is the
// visible symptom of that guarantee having failed, so it must not be folded into the first:
// telling an administrator that an owner has no e-mail when the registry says otherwise
// sends them to correct data that is already correct.
const ownersWithoutEmail = ownerRows.filter((owner) => !owner.hasLink && owner.email === null);
const ownersMissingLink = ownerRows.filter((owner) => !owner.hasLink && owner.email !== null);

const openedAtLabel = resolution?.opened_at != null ? formatResolutionDate(resolution.opened_at) : null;

/**
 * The three derived states, in the order the migration defines them. Kept as one function
 * so the page cannot drift from the rule: sent wins over everything, a failed attempt is
 * only "failed" while nothing has succeeded since, and no attempt at all is "niewysłane".
 */
type SendStatus = { kind: "sent"; at: string } | { kind: "error"; sentence: string } | { kind: "pending" };

const sendStatusOf = (owner: OwnerRow): SendStatus => {
  if (owner.send === null || owner.send.attemptCount === 0) return { kind: "pending" };
  if (owner.send.sentAt !== null) return { kind: "sent", at: owner.send.sentAt };
  // attemptCount > 0 and never sent. lastErrorCode should be present; if a row somehow
  // carries neither, the fallback sentence still names what is knowable.
  return { kind: "error", sentence: describeSendFailure(owner.send.lastErrorCode ?? "E_UNKNOWN") };
};

// Owners still to be reached by a press of the button: they hold a link that has not been
// sent. This drives the button's label and its count, so a second press advertises exactly
// what it will do rather than repeating the first press's number.
const unsentCount = ownerRows.filter((owner) => owner.hasLink && owner.send?.sentAt == null).length;
const anySent = ownerRows.some((owner) => owner.send?.sentAt != null);

const inputClass =
  "w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/40 transition-colors focus:border-purple-400/50 focus:ring-2 focus:ring-purple-400 focus:outline-none";
---

<Layout title={resolution ? resolution.title : "Uchwała"}>
  <div class="bg-cosmic min-h-screen p-4 py-12">
    <div
      class="mx-auto w-full max-w-4xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl"
    >
      {
        loadError ? (
          <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300" role="alert">
            {loadError}
          </p>
        ) : (
          building &&
          resolution && (
            <>
              <div class="mb-6">
                <div class="flex flex-wrap items-center gap-3">
                  <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
                    Uchwała {resolution.number}
                  </h1>
                  <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-medium", statusBadge.className]}>
                    {statusBadge.label}
                  </span>
                </div>
                <p class="mt-1 text-sm text-blue-100/60">
                  {building.name} — {building.street}, {building.city}
                </p>
                {openedAtLabel && <p class="mt-1 text-sm text-blue-100/60">Głosowanie otwarte od {openedAtLabel}</p>}
              </div>

              {error && (
                <p
                  class="mb-6 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300"
                  role="alert"
                >
                  {error}
                </p>
              )}

              {notice && (
                <p class="mb-6 rounded-lg border border-blue-400/30 bg-blue-500/10 px-3 py-2 text-sm text-blue-100">
                  {notice}
                </p>
              )}

              {/* The run summary: counts only, parsed as numbers. Nothing from the query
                  string is echoed as prose, so a doctored URL cannot put text on this page. */}
              {hasRunSummary && (
                <div class="mb-6 rounded-lg border border-green-400/30 bg-green-500/10 px-3 py-2 text-sm text-green-100">
                  <p>
                    Wysłano linki: <span class="font-medium text-white">{sentCount}</span>
                    {failedCount > 0 && (
                      <>
                        {" · "}
                        nie udało się: <span class="font-medium text-red-200">{failedCount}</span>
                      </>
                    )}
                    {ownersWithoutEmail.length > 0 && (
                      <>
                        {" · "}
                        bez adresu e-mail: <span class="font-medium text-amber-200">{ownersWithoutEmail.length}</span>
                      </>
                    )}
                  </p>
                  {failedCount > 0 && (
                    <p class="mt-1 text-xs text-green-100/70">
                      Powód niepowodzenia jest podany przy każdym właścicielu w tabeli poniżej.
                    </p>
                  )}
                  {unrecordedCount > 0 && (
                    <p class="mt-2 rounded border border-amber-400/40 bg-amber-500/10 px-2 py-1 text-xs text-amber-100">
                      Uwaga: <span class="font-medium">{unrecordedCount}</span> wiadomości wysłano, ale nie udało się
                      zapisać tego w bazie. Ci właściciele mają już swój link — kolejne naciśnięcie przycisku wyśle im
                      go po raz drugi.
                    </p>
                  )}
                </div>
              )}

              {isDraft ? (
                <>
                  <form
                    method="POST"
                    action={`/api/buildings/${building.id}/resolutions/${resolution.id}`}
                    class="space-y-4"
                  >
                    <div>
                      <label for="number" class="mb-1 block text-sm text-blue-100/80">
                        Numer uchwały
                      </label>
                      <input
                        id="number"
                        name="number"
                        type="text"
                        maxlength="50"
                        required
                        value={resolution.number}
                        class:list={inputClass}
                      />
                    </div>

                    <div>
                      <label for="title" class="mb-1 block text-sm text-blue-100/80">
                        Tytuł
                      </label>
                      <input
                        id="title"
                        name="title"
                        type="text"
                        maxlength="200"
                        required
                        value={resolution.title}
                        class:list={inputClass}
                      />
                    </div>

                    <div>
                      <label for="body" class="mb-1 block text-sm text-blue-100/80">
                        Treść uchwały
                      </label>
                      {/* set:text rather than children: the template's own indentation and
                          newlines would otherwise land inside the textarea, and a body
                          rendered with a blank first line looks like corrupted data. */}
                      <textarea
                        id="body"
                        name="body"
                        rows="12"
                        maxlength="20000"
                        required
                        class:list={inputClass}
                        set:text={resolution.body}
                      />
                    </div>

                    <button
                      type="submit"
                      class="w-full rounded-lg border border-white/20 bg-white/5 px-4 py-2 font-medium text-white transition-colors hover:border-purple-400/50 hover:bg-white/10"
                    >
                      Zapisz zmiany
                    </button>
                  </form>

                  <div class="mt-8 rounded-xl border border-purple-400/30 bg-purple-500/10 p-4">
                    <h2 class="text-lg font-semibold">Uruchom głosowanie</h2>
                    <p class="mt-1 text-sm text-blue-100/80">
                      Każdy właściciel z adresem e-mail dostanie własny link do głosowania. Od tej chwili treści uchwały
                      nie da się już zmienić — właściciele głosują nad tym, co widzą pod swoim linkiem.
                    </p>
                    <form
                      method="POST"
                      action={`/api/buildings/${building.id}/resolutions/${resolution.id}/open`}
                      class="mt-4"
                    >
                      <button
                        type="submit"
                        class="w-full rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
                      >
                        Uruchom głosowanie
                      </button>
                    </form>
                  </div>
                </>
              ) : (
                <>
                  <div class="rounded-xl border border-white/10 bg-white/5 p-5">
                    <h2 class="text-lg font-semibold">{resolution.title}</h2>
                    {/* Same reason as the draft's textarea: whitespace-pre-wrap would
                        otherwise render the template's indentation as part of the text. */}
                    <p class="mt-3 text-sm whitespace-pre-wrap text-blue-100/80" set:text={resolution.body} />
                  </div>

                  {/* Sits in the non-draft branch only: before the vote is opened there are
                      no links and no votes, and a "Zagłosowało 0 z 0" on a draft would read
                      as a result rather than as an empty state. */}
                  <div class="mt-6 rounded-xl border border-white/10 bg-white/5 p-4">
                    <p class="text-sm text-blue-100/80">
                      Zagłosowało <span class="font-medium text-white">{voteCount}</span> z
                      <span class="font-medium text-white"> {linkedOwners.length} </span>
                      właścicieli
                    </p>
                    <p class="mt-1 text-xs text-blue-100/60">
                      To liczba osób, a nie udziałów. O przyjęciu uchwały decydują wyłącznie udziały — ten licznik
                      pokazuje tylko, ilu właścicieli zdążyło oddać głos.
                    </p>
                  </div>

                  <div class="mt-8 mb-4 flex flex-wrap items-baseline justify-between gap-2">
                    <h2 class="text-lg font-semibold">Linki do głosowania</h2>
                    <p class="text-sm text-blue-100/60">
                      Właścicieli z linkiem: <span class="font-medium text-white">{linkedOwners.length}</span>
                    </p>
                  </div>

                  <p class="mb-4 text-sm text-blue-100/70">
                    Linki są zapisane w bazie i nie są tutaj pokazywane — link jest jedynym dowodem tożsamości
                    głosującego, więc trafia wyłącznie do właściciela, na jego adres e-mail.
                  </p>

                  {/* Deliberately NOT gated on isEmailConfigured(): a missing binding is
                      recorded per owner as E_BINDING_MISSING like any other failure and
                      cleared by the resume once it returns. Hiding the button would turn
                      the only failure this slice can deliberately produce into an
                      unreachable branch. */}
                  {unsentCount > 0 && (
                    <div class="mb-6 rounded-xl border border-purple-400/30 bg-purple-500/10 p-4">
                      <h3 class="text-sm font-semibold">{anySent ? "Dokończ rozsyłkę" : "Roześlij linki"}</h3>
                      <p class="mt-1 text-sm text-blue-100/80">
                        Każdy właściciel dostanie osobną wiadomość z treścią uchwały i swoim własnym linkiem. Wysyłka
                        dużego budynku trwa do około minuty — nie zamykaj tej strony. Jeśli przerwiesz, nic nie
                        przepadnie: naciśnij przycisk ponownie, a wyślemy tylko do tych, którzy jeszcze nie dostali
                        linku. Nikt nie dostanie wiadomości dwa razy.
                      </p>
                      <form
                        method="POST"
                        action={`/api/buildings/${building.id}/resolutions/${resolution.id}/send`}
                        class="mt-4"
                        data-send-form
                      >
                        <button
                          type="submit"
                          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500 disabled:cursor-not-allowed disabled:opacity-60"
                          data-send-button
                        >
                          {anySent ? `Wyślij pozostałe linki (${unsentCount})` : `Roześlij linki (${unsentCount})`}
                        </button>
                      </form>
                    </div>
                  )}

                  <div class="overflow-x-auto rounded-xl border border-white/10">
                    <table class="w-full text-left text-sm">
                      <thead class="bg-white/5 text-xs tracking-wide text-blue-100/60 uppercase">
                        <tr>
                          <th scope="col" class="px-4 py-3 font-medium">
                            Właściciel
                          </th>
                          <th scope="col" class="px-4 py-3 font-medium">
                            E-mail
                          </th>
                          <th scope="col" class="px-4 py-3 font-medium">
                            Lokale
                          </th>
                          <th scope="col" class="px-4 py-3 text-right font-medium">
                            Udział
                          </th>
                          <th scope="col" class="px-4 py-3 font-medium">
                            Status linku
                          </th>
                          <th scope="col" class="px-4 py-3 font-medium">
                            Wysyłka
                          </th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-white/5">
                        {linkedOwners.map((owner) => {
                          const status = sendStatusOf(owner);
                          return (
                            <tr>
                              <td class="px-4 py-3 font-medium">{owner.fullName}</td>
                              <td class="px-4 py-3">{owner.email}</td>
                              <td class="px-4 py-3">{owner.unitNumbers.join(", ")}</td>
                              <td class="px-4 py-3 text-right tabular-nums">{formatShareBps(owner.shareBps)}</td>
                              <td class="px-4 py-3">
                                <span class="rounded-full border border-green-400/40 bg-green-500/10 px-2.5 py-0.5 text-xs font-medium text-green-200">
                                  Wystawiony
                                </span>
                              </td>
                              <td class="px-4 py-3">
                                {status.kind === "sent" && (
                                  <span class="rounded-full border border-green-400/40 bg-green-500/10 px-2.5 py-0.5 text-xs font-medium text-green-200">
                                    Wysłano {formatResolutionDate(status.at)}
                                  </span>
                                )}
                                {status.kind === "error" && (
                                  <>
                                    <span class="rounded-full border border-red-400/40 bg-red-500/10 px-2.5 py-0.5 text-xs font-medium text-red-200">
                                      Błąd
                                    </span>
                                    <span class="mt-1 block text-xs text-red-200/80">{status.sentence}</span>
                                  </>
                                )}
                                {status.kind === "pending" && (
                                  <span class="rounded-full border border-white/20 bg-white/10 px-2.5 py-0.5 text-xs font-medium text-blue-100/70">
                                    Niewysłane
                                  </span>
                                )}
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>

                  {ownersMissingLink.length > 0 && (
                    <div class="mt-6 rounded-xl border border-red-500/40 bg-red-900/30 p-4" role="alert">
                      <h3 class="text-sm font-medium text-red-200">Brakuje linków do głosowania</h3>
                      <p class="mt-1 text-sm text-red-200/90">
                        Ci właściciele mają adres e-mail w rejestrze, ale nie powstał dla nich link. Naciśnij
                        <span class="font-medium"> Uruchom głosowanie </span>
                        jeszcze raz — brakujące linki zostaną wystawione, a te już istniejące pozostaną bez zmian.
                      </p>
                      <ul class="mt-3 space-y-1 text-sm text-red-100">
                        {ownersMissingLink.map((owner) => (
                          <li>
                            {owner.fullName} — {owner.unitNumbers.join(", ")} ({formatShareBps(owner.shareBps)})
                          </li>
                        ))}
                      </ul>
                      <form
                        method="POST"
                        action={`/api/buildings/${building.id}/resolutions/${resolution.id}/open`}
                        class="mt-4"
                      >
                        <button
                          type="submit"
                          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
                        >
                          Uruchom głosowanie
                        </button>
                      </form>
                    </div>
                  )}

                  {ownersWithoutEmail.length > 0 && (
                    <div class="mt-6 rounded-xl border border-amber-400/30 bg-amber-500/10 p-4">
                      <h3 class="text-sm font-medium text-amber-100">Właściciele bez linku</h3>
                      <p class="mt-1 text-sm text-amber-100/80">
                        Ci właściciele nie mają adresu e-mail w rejestrze, więc nie powstał dla nich link. Nie dostaną
                        żadnej wiadomości i trzeba dotrzeć do nich poza aplikacją — listownie lub osobiście. Nie są
                        liczeni jako nieudana wysyłka, bo nie było czego wysłać; ich udziały nadal liczą się do progu
                        większości.
                      </p>
                      <ul class="mt-3 space-y-1 text-sm text-amber-100/90">
                        {ownersWithoutEmail.map((owner) => (
                          <li>
                            {owner.fullName} — {owner.unitNumbers.join(", ")} ({formatShareBps(owner.shareBps)})
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </>
              )}
            </>
          )
        )
      }

      <p class="mt-8 text-center text-sm">
        <a
          href={building ? `/buildings/${building.id}/resolutions` : "/buildings"}
          class="text-blue-200/80 underline-offset-4 transition-colors hover:text-white hover:underline"
        >
          Wróć do uchwał
        </a>
      </p>
    </div>
  </div>
</Layout>

<script>
  // The fanout holds the request open for as long as the run takes -- tens of seconds for a
  // large building. Without this, the button looks idle and invites a second press, which
  // would start a concurrent run from the same tab and race the first one's status writes.
  //
  // The disable is deferred by a tick on purpose: disabling a submit button synchronously
  // inside its own submit handler cancels the submission in some browsers.
  const form = document.querySelector<HTMLFormElement>("[data-send-form]");
  const button = document.querySelector<HTMLButtonElement>("[data-send-button]");

  form?.addEventListener("submit", () => {
    setTimeout(() => {
      if (button) {
        button.disabled = true;
        button.textContent = "Wysyłanie…";
      }
    }, 0);
  });
</script>
