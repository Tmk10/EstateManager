---
import AppShell from "@/components/AppShell.astro";
import { createClient } from "@/lib/supabase";
import {
  CARD_PADDED,
  PAGE_TITLE,
  MUTED_TEXT,
  FINE_PRINT,
  LABEL,
  INPUT,
  BUTTON_PRIMARY_BLOCK,
  BUTTON_PRIMARY,
  ALERT_ERROR,
  EMPTY_STATE,
  NAV_LINK,
} from "@/lib/ui";

const { id } = Astro.params;

// Middleware has already bounced anonymous visitors (PROTECTED_ROUTES covers "/buildings").
const supabase = createClient(Astro.request.headers, Astro.cookies);

// The endpoint redirects back here with ?error=<message> rather than returning a JSON body.
const error = Astro.url.searchParams.get("error");

let loadError: string | null = null;
let building: { id: string; name: string; city: string; street: string } | null = null;
let hasRegistry = false;

if (!supabase) {
  loadError = "Baza danych nie jest skonfigurowana.";
} else if (!id) {
  loadError = "Nie znaleziono budynku.";
} else {
  const { data, error: buildingError } = await supabase
    .from("buildings")
    .select("id, name, city, street")
    .eq("id", id)
    .maybeSingle();

  if (buildingError) {
    // 22P02 is invalid_text_representation — the id in the URL is not a uuid at all.
    loadError = buildingError.code === "22P02" ? "Nie znaleziono budynku." : buildingError.message;
  } else if (!data) {
    loadError = "Nie znaleziono budynku.";
  } else {
    building = data;

    // Checked before the form is offered, not after it is filled in: a resolution in a
    // building with no registry has nobody to send a link to, so it could be written and
    // never opened. The same reason the import page checks for an existing registry up
    // front rather than letting EM002 explain it afterwards.
    const { count, error: countError } = await supabase
      .from("owners")
      .select("id", { count: "exact", head: true })
      .eq("building_id", id);

    if (countError) {
      loadError = countError.message;
    } else {
      hasRegistry = (count ?? 0) > 0;
    }
  }
}
---

<AppShell title="Nowa uchwała">
  {
    loadError ? (
      <p class:list={ALERT_ERROR} role="alert">
        {loadError}
      </p>
    ) : (
      building && (
        <>
          <div class="mb-6">
            <h1 class:list={PAGE_TITLE}>Nowa uchwała</h1>
            <p class:list={["mt-1", MUTED_TEXT]}>
              {building.name} — {building.street}, {building.city}
            </p>
          </div>

          {hasRegistry ? (
            <div class:list={CARD_PADDED}>
              <p class:list={["mb-6", MUTED_TEXT]}>
                Uchwała powstaje jako wersja robocza — nikt jej nie widzi i można ją poprawiać. Linki do głosowania
                powstaną dopiero po uruchomieniu głosowania.
              </p>

              {error && (
                <p class:list={[ALERT_ERROR, "mb-6"]} role="alert">
                  {error}
                </p>
              )}

              <form method="POST" action={`/api/buildings/${building.id}/resolutions`} class="space-y-5">
                <div>
                  <label for="number" class:list={LABEL}>
                    Numer uchwały
                  </label>
                  <input
                    id="number"
                    name="number"
                    type="text"
                    maxlength="50"
                    required
                    placeholder="1/2026"
                    class:list={INPUT}
                  />
                </div>

                <div>
                  <label for="title" class:list={LABEL}>
                    Tytuł
                  </label>
                  <input
                    id="title"
                    name="title"
                    type="text"
                    maxlength="200"
                    required
                    placeholder="Remont dachu"
                    class:list={INPUT}
                  />
                </div>

                <div>
                  <label for="body" class:list={LABEL}>
                    Treść uchwały
                  </label>
                  <textarea id="body" name="body" rows="10" maxlength="20000" required class:list={INPUT} />
                </div>

                <button type="submit" class:list={BUTTON_PRIMARY_BLOCK}>
                  Zapisz wersję roboczą
                </button>
              </form>
            </div>
          ) : (
            <div class:list={EMPTY_STATE}>
              <p class="text-foreground text-sm">Ten budynek nie ma jeszcze rejestru lokali.</p>
              <p class:list={["mt-1", FINE_PRINT]}>
                Bez rejestru nie wiadomo, komu wystawić link do głosowania i jaki ma udział. Wczytaj lokale, zanim
                napiszesz uchwałę.
              </p>
              <a href={`/buildings/${building.id}/units/import`} class:list={[BUTTON_PRIMARY, "mt-5"]}>
                Wczytaj lokale z pliku CSV
              </a>
            </div>
          )}
        </>
      )
    )
  }

  <p class="mt-6 text-center text-sm">
    <a href={building ? `/buildings/${building.id}/resolutions` : "/buildings"} class:list={NAV_LINK}>Wróć do uchwał</a>
  </p>
</AppShell>
