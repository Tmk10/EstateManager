---
import Layout from "@/layouts/Layout.astro";
import BuildingHeader from "@/components/buildings/BuildingHeader.astro";
import { createClient } from "@/lib/supabase";
import { formatResolutionDate, describeResolutionStatus, isResolutionDecided } from "@/lib/resolutions";

// The voting module of a building (roadmap `S-09`, level 2). This file was written twice: once
// here by `S-05`, once on the `S-09` branch, which had been cut before `S-05` existed. `S-05`'s
// version won the merge — it is the one that knows `decided_at` and the *Podjęta* / *Upadła*
// badge — and `S-09` contributed the module header and the empty-registry guard below.

const { id } = Astro.params;

// Middleware has already bounced anonymous visitors: PROTECTED_ROUTES contains "/buildings"
// and is matched with startsWith, so this route was protected the moment the file existed.
// No entry had to be added for it — do not add one, it would be dead weight in the only auth
// gate this application has.
const supabase = createClient(Astro.request.headers, Astro.cookies);

const error = Astro.url.searchParams.get("error");

let loadError: string | null = null;
let building: { id: string; name: string; city: string; street: string } | null = null;
let hasRegistry = false;
let resolutions: {
  id: string;
  number: string;
  title: string;
  status: string;
  opened_at: string | null;
  decided_at: string | null;
}[] = [];

if (!supabase) {
  loadError = "Baza danych nie jest skonfigurowana.";
} else if (!id) {
  loadError = "Nie znaleziono budynku.";
} else {
  const { data: buildingData, error: buildingError } = await supabase
    .from("buildings")
    .select("id, name, city, street")
    .eq("id", id)
    .maybeSingle();

  if (buildingError) {
    // 22P02 is invalid_text_representation — the id in the URL is not a uuid at all.
    loadError = buildingError.code === "22P02" ? "Nie znaleziono budynku." : buildingError.message;
  } else if (!buildingData) {
    loadError = "Nie znaleziono budynku.";
  } else {
    building = buildingData;

    // Whether a uchwała can be written at all: without owners there is nobody to issue a voting
    // link to. One row answers it. This guard replaces one the building page used to provide by
    // hiding the uchwały section until the registry was imported — since S-09 the voting module
    // is always on the building's index, so the "co jest pierwsze" answer has to live here.
    const { data: unitRows, error: unitsError } = await supabase
      .from("units")
      .select("id")
      .eq("building_id", id)
      .limit(1);

    if (unitsError) {
      loadError = unitsError.message;
    } else {
      hasRegistry = unitRows.length > 0;

      // One list, running and finished together — the status badge is what tells them apart.
      // Splitting decided uchwały onto their own screen would make an administrator guess which
      // screen to look on before knowing whether the vote had finished.
      //
      // Newest first: far more likely to be looking for the uchwała written a minute ago.
      const { data: resolutionRows, error: resolutionsError } = await supabase
        .from("resolutions")
        .select("id, number, title, status, opened_at, decided_at")
        .eq("building_id", id)
        .order("created_at", { ascending: false });

      if (resolutionsError) {
        loadError = resolutionsError.message;
      } else {
        resolutions = resolutionRows;
      }
    }
  }
}
---

<Layout title={building ? `Uchwały — ${building.name}` : "Uchwały"}>
  <div class="bg-cosmic min-h-screen p-4 py-12">
    <div
      class="mx-auto w-full max-w-4xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl"
    >
      {
        loadError ? (
          <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300" role="alert">
            {loadError}
          </p>
        ) : (
          building && (
            <>
              <BuildingHeader building={building} activeModule="resolutions" />

              {error && (
                <p
                  class="mb-6 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300"
                  role="alert"
                >
                  {error}
                </p>
              )}

              <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-lg font-semibold">
                  Uchwały <span class="ml-1 text-sm font-normal text-blue-100/60">{resolutions.length}</span>
                </h2>
                {hasRegistry && (
                  <a
                    href={`/buildings/${building.id}/resolutions/new`}
                    class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium transition-colors hover:bg-purple-500"
                  >
                    Nowa uchwała
                  </a>
                )}
              </div>

              {!hasRegistry ? (
                <div class="rounded-xl border border-dashed border-white/10 bg-white/5 px-4 py-10 text-center">
                  <p class="text-blue-100/80">Ten budynek nie ma jeszcze rejestru lokali.</p>
                  <p class="mt-1 text-sm text-blue-100/50">
                    Bez rejestru nie wiadomo, komu wystawić link do głosowania i jaki ma udział. Wczytaj lokale, zanim
                    napiszesz uchwałę.
                  </p>
                  <a
                    href={`/buildings/${building.id}/units/import`}
                    class="mt-5 inline-block rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium transition-colors hover:bg-purple-500"
                  >
                    Wczytaj lokale z pliku CSV
                  </a>
                </div>
              ) : resolutions.length > 0 ? (
                <ul class="divide-y divide-white/5 overflow-hidden rounded-xl border border-white/10">
                  {resolutions.map((item) => {
                    const badge = describeResolutionStatus(item.status);
                    // A decided uchwała is dated by when it was decided; one still running, by
                    // when it opened. Never both, and never the difference between them:
                    // opened_at carries the Worker's clock and decided_at the database's.
                    const timestamp = isResolutionDecided(item.status) ? item.decided_at : item.opened_at;
                    const timestampLabel = isResolutionDecided(item.status) ? "rozstrzygnięta" : "od";

                    return (
                      <li>
                        <a
                          href={`/buildings/${building.id}/resolutions/${item.id}`}
                          class="flex flex-wrap items-baseline justify-between gap-2 px-4 py-3 transition-colors hover:bg-white/5"
                        >
                          <span class="text-sm">
                            <span class="font-medium">{item.number}</span>
                            <span class="text-blue-100/70"> — {item.title}</span>
                          </span>
                          <span class="flex items-baseline gap-3 text-xs">
                            {timestamp !== null && (
                              <span class="text-blue-100/50">
                                {timestampLabel} {formatResolutionDate(timestamp)}
                              </span>
                            )}
                            <span class:list={["rounded-full px-2.5 py-0.5 font-medium", badge.className]}>
                              {badge.label}
                            </span>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <div class="rounded-xl border border-dashed border-white/10 bg-white/5 px-4 py-8 text-center">
                  <p class="text-blue-100/80">Ten budynek nie ma jeszcze żadnej uchwały.</p>
                  <p class="mt-1 text-sm text-blue-100/50">
                    Napisz uchwałę, a po uruchomieniu głosowania każdy właściciel dostanie własny link.
                  </p>
                </div>
              )}
            </>
          )
        )
      }

      <p class="mt-8 text-center text-sm">
        <a
          href={building ? `/buildings/${building.id}` : "/buildings"}
          class="text-blue-200/80 underline-offset-4 transition-colors hover:text-white hover:underline"
        >
          Wróć do budynku
        </a>
      </p>
    </div>
  </div>
</Layout>
