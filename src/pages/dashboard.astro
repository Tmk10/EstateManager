---
import AppShell from "@/components/AppShell.astro";
import { CARD_PADDED, PAGE_TITLE, SECTION_TITLE, MUTED_TEXT, BUTTON_PRIMARY } from "@/lib/ui";

const { user } = Astro.locals;

// The panel is a greeting and one first step — not a menu.
//
// It used to be the menu: two tiles in the middle of the page, one per application module. They
// moved to the rail on the left on 2026-08-05 (`src/components/SideNav.astro`), on the product
// owner's instruction, and were not copied here — a list of modules in the middle of the screen
// and the same list beside it is the duplication the topbar's nav links were just deleted for.
//
// **This is still not `S-09` level 1 in full.** That slice's registry now exists
// (`src/lib/app-modules.ts`) and the rail reads it, so the half that was missing is the half
// this page used to fake with two hand-written tiles. What is left of the slice is whatever the
// panel should say once there is state worth summarising here; two tiles were never that.
//
// The sign-out button that used to sit here is gone, not lost: the topbar carries it on every
// screen, and two ways to sign out on one page makes an interface feel larger than it is.
---

<AppShell title="Panel">
  <h1 class:list={PAGE_TITLE}>Panel</h1>
  <p class:list={["mt-1", MUTED_TEXT]}>
    Zalogowano jako <span class="text-foreground font-medium">{user?.email}</span> — administrator.
  </p>

  <div class:list={[CARD_PADDED, "mt-8"]}>
    <h2 class:list={SECTION_TITLE}>Od czego zacząć</h2>
    <p class:list={["mt-1", MUTED_TEXT]}>
      Moduły aplikacji są w menu po lewej stronie. Praca zaczyna się od budynku — to w nim mieszka rejestr lokali i
      głosowanie nad uchwałami.
    </p>
    <a href="/buildings" class:list={[BUTTON_PRIMARY, "mt-4"]}>Przejdź do budynków</a>
  </div>
</AppShell>
