---
import AppShell from "@/components/AppShell.astro";
import { CARD, PAGE_TITLE, SECTION_TITLE, MUTED_TEXT } from "@/lib/ui";

const { user } = Astro.locals;

// **This is not `S-09` level 1.** That slice makes this page a list of *application* modules
// read from a registry, the way `/buildings/<id>` reads `src/lib/building-modules.ts`, and it
// is still unbuilt. What is below is the same two destinations the page already offered,
// wearing the same clothes as the rest of the product. Building the registry is a roadmap
// slice with its own change folder; do not read these two tiles as it having happened.
//
// The sign-out button that used to sit here is gone, not lost: the topbar carries it on every
// screen now, and two ways to sign out on one page is the kind of duplication that makes an
// interface feel larger than it is.
const DESTINATIONS = [
  {
    href: "/buildings",
    label: "Budynki",
    description: "Wspólnoty, rejestry lokali i głosowania nad uchwałami.",
  },
  {
    href: "/help",
    label: "Pomoc",
    description: "Kontakt do osoby, która prowadzi tę aplikację.",
  },
];
---

<AppShell title="Panel">
  <h1 class:list={PAGE_TITLE}>Panel</h1>
  <p class:list={["mt-1", MUTED_TEXT]}>
    Zalogowano jako <span class="text-foreground font-medium">{user?.email}</span> — administrator.
  </p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      DESTINATIONS.map((item) => (
        <li class:list={[CARD, "hover:border-ring hover:bg-accent/40 relative p-5 transition-colors"]}>
          <h2 class:list={SECTION_TITLE}>
            {/* The pseudo-element stretches the link over the whole tile, so the tile is one
                target rather than a paragraph with a small link in it. */}
            <a href={item.href} class="after:absolute after:inset-0">
              {item.label}
            </a>
          </h2>
          <p class:list={["mt-1", MUTED_TEXT]}>{item.description}</p>
        </li>
      ))
    }
  </ul>
</AppShell>
