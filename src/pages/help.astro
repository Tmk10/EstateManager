---
import AppShell from "@/components/AppShell.astro";
import { CARD_PADDED, PAGE_TITLE, MUTED_TEXT, LINK } from "@/lib/ui";

// Middleware has already bounced anonymous visitors (PROTECTED_ROUTES), so reaching
// this line means there is a signed-in administrator. The module is deliberately
// closed to anonymous visitors — an owner voting from a per-unit link (S-02) does
// not see it and contacts the manager instead.
//
// v1 is one sentence on purpose. Further content (FAQ, instrukcja importu, opis
// progu 50%) belongs in this page as another block; navigation belongs to S-09.
const DEVELOPER_EMAIL = "tomek.maq@gmail.com";
---

<AppShell title="Pomoc">
  <div class:list={CARD_PADDED}>
    <h1 class:list={PAGE_TITLE}>Pomoc</h1>

    <p class:list={["mt-4", MUTED_TEXT]}>
      W przypadku problemów skontaktuj się z deweloperem:
      <a href={`mailto:${DEVELOPER_EMAIL}`} class:list={LINK}>{DEVELOPER_EMAIL}</a>
    </p>
  </div>
</AppShell>
