---
import AppShell from "@/components/AppShell.astro";
import SignInForm from "@/components/auth/SignInForm";
import { CARD_PADDED, PAGE_TITLE, MUTED_TEXT, PANEL } from "@/lib/ui";

const error = Astro.url.searchParams.get("error");
---

<AppShell title="Logowanie" width="narrow">
  <div class:list={CARD_PADDED}>
    <h1 class:list={PAGE_TITLE}>Zaloguj się</h1>
    <p class:list={["mt-1 mb-6", MUTED_TEXT]}>Panel administratora wspólnoty.</p>

    <div class:list={[PANEL, "mb-6 text-sm"]} role="note">
      <p class="text-muted-foreground">
        Konta administratorów zakładane są bezpośrednio w bazie danych, przez panel Supabase — aplikacja nie ma
        rejestracji.
      </p>
      <p class="text-muted-foreground mt-2">
        Konto testowe na czas MVP: <span class="text-foreground font-medium">test@test.com</span>, hasło
        <span class="text-foreground font-medium">Test123!</span>.
      </p>
    </div>

    <SignInForm serverError={error} client:load />
  </div>
</AppShell>
