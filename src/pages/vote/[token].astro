---
import "@/styles/global.css";
import { createClient } from "@/lib/supabase";
import { formatShareBps } from "@/lib/shares";
import { formatResolutionDate, isResolutionDecided } from "@/lib/resolutions";
import {
  CARD_PADDED,
  PANEL,
  PAGE_TITLE,
  SECTION_TITLE,
  MUTED_TEXT,
  BUTTON_PRIMARY_BLOCK,
  BUTTON_SECONDARY_BLOCK,
  ALERT,
  ALERT_TONES,
  ALERT_ERROR,
} from "@/lib/ui";

/**
 * The only route in this application reachable without a session.
 *
 * Everything it may show comes from public.resolve_voting_link, whose return list IS the
 * visibility contract for a caller with no session — no e-mail address, no other owner, no
 * per-unit area, no other owner's vote. This page must never join to anything to widen that
 * list.
 *
 * Three properties are load-bearing and easy to break by accident:
 *
 *   1. **One answer for every failure.** An unknown token, a truncated token, a token whose
 *      resolution is still a draft, an RPC error and an unconfigured client all render the
 *      same neutral page with the same 200 — and now with the same headers, which are set
 *      before anything is resolved. Any branch that lets a reader tell those apart turns the
 *      token space into something worth probing. That includes the `?error=` message, which
 *      is rendered only in the states this page reaches with a resolved token: the neutral
 *      branch ignores it entirely, so the vote endpoint may name a write failure without
 *      naming it to someone holding a token that resolves to nothing.
 *   2. **The token appears in exactly one attribute, and never as text.** S-03 revised this
 *      property rather than kept it: casting a vote without JavaScript means posting a form,
 *      and a form must name where it posts, so the confirm screen carries
 *      `action="/api/vote/<token>"`. Nothing else does — the two GET forms deliberately have
 *      no `action`, which submits them to the current URL and keeps the token out of their
 *      markup. What the property protects is unchanged: the token is a bearer secret and
 *      possession of it is the voter's identity until PRD Open Question no. 1 closes, so it
 *      must not travel to anyone who does not already hold it. The reader of this markup is
 *      exactly that holder. Do not add a second place — no anchor, no hidden field, no text.
 *   3. **No outbound links, anywhere.** A click on one would put the token in a Referer
 *      header on its way to a third party. `Referrer-Policy: same-origin` below is the
 *      belt to that suspenders, not a replacement for it. This is also why the page does not
 *      use Layout.astro: the configuration banner it renders carries an external
 *      documentation link when Supabase is unset, which is exactly the state this page can
 *      be in.
 *
 * The vote itself is three states grown out of what S-02 left: buttons → confirm → receipt.
 * The first step is a GET, so the back button and a double tap are harmless; only the
 * confirm screen writes.
 */

const { token } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);

// Set BEFORE anything is resolved, and unconditionally. A header that differs between a hit
// and a miss is exactly as observable as a body that does, so these cannot sit inside the
// branch that knows whether the token resolved. (S-02 implementation review, finding F4:
// recorded there and skipped, because nothing could yet be lost; added here, because now a
// cast vote can be.)
//
//   no-store   — the receipt names how someone voted; a shared or proxied cache must not
//                keep it, and neither must the browser's back-forward cache.
//   noindex    — a token in a crawler's index is a token in a search result.
//   same-origin— the token is in this URL, so every outbound request would otherwise carry
//                it. There are no outbound links, and this holds even if one is added: the
//                referrer only ever travels within this origin, same as no-referrer would
//                give. Not literally no-referrer, though: per the Fetch standard, a
//                no-referrer policy also nulls the *Origin* header on this page's own POST
//                (the confirm-vote form), even though that POST is same-origin -- which
//                Astro's built-in CSRF check then rejects as a forbidden cross-site
//                submission. same-origin keeps the leak-prevention property without that
//                side effect, because it only nulls Origin/Referer for requests that
//                actually cross an origin.
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "same-origin");

/** The database's vocabulary (votes_choice_known), which is also cast_vote's. */
type Choice = "for" | "against";

/**
 * The `?wybor` value, in Polish because an owner may read it in their address bar, mapped
 * to the vocabulary the database stores.
 *
 * Caller-controlled, so it says nothing about the token: an unrecognised value falls through
 * to the buttons exactly as a missing one does, rather than erroring. Erroring here would be
 * the page's only answer that depends on something other than whether the token resolved.
 */
function parseChoice(value: string | null): Choice | null {
  if (value === "za") return "for";
  if (value === "przeciw") return "against";
  return null;
}

function choiceLabel(choice: string): string {
  if (choice === "for") return "Za";
  if (choice === "against") return "Przeciw";
  // Unreachable — votes_choice_known permits nothing else. Returned raw rather than defaulted
  // to one of the two, so a widened vocabulary shows up as an obviously wrong label instead
  // of quietly rendering as the wrong vote.
  return choice;
}

interface VoteView {
  buildingName: string;
  resolutionNumber: string;
  resolutionTitle: string;
  resolutionBody: string;
  /**
   * `open`, `passed` or `rejected` — never `draft`, which resolve_voting_link filters out.
   * Read since S-05, and reading it is what stops this page offering a vote on an uchwała
   * that has already been settled: cast_vote requires `open`, so the buttons would post, be
   * refused, and land the reader back here with no explanation, forever.
   */
  resolutionStatus: string;
  ownerFullName: string;
  ownerUnitNumbers: string[];
  ownerShareBps: number;
  /**
   * The reader's own vote, null until they cast one. The generated types call both of these
   * plain `string` — the generator reads resolve_voting_link's `returns table` declaration,
   * not the left join behind it — so they are widened here to what the database can actually
   * return, and read through truthiness rather than a `=== null` the declared type would
   * make look impossible.
   */
  ownVoteChoice: string | null;
  ownVotedAt: string | null;
  /**
   * The one attribute in this page that carries the token (property 2 above). It lives on
   * the resolved view on purpose: a page with no resolution has no form to post, so the
   * token has nowhere to leak into the neutral markup.
   */
  castAction: string;
}

type VoteState =
  | { kind: "receipt"; choice: string; votedAt: string }
  | { kind: "confirm"; choice: Choice }
  | { kind: "buttons" }
  /** Settled, and this reader never voted. There is nothing to press and nothing to confirm. */
  | { kind: "closed" }
  | { kind: "neutral" };

let view: VoteView | null = null;

if (supabase && token) {
  // No pre-validation of the token's shape. The function is the single decider of what a
  // token resolves to, and a second opinion here could only ever disagree with it — a
  // rejected-before-lookup token would answer faster than a looked-up one, which is a
  // difference a reader can measure.
  const { data, error } = await supabase.rpc("resolve_voting_link", { p_token: token });

  if (!error && data.length > 0) {
    const row = data[0];
    view = {
      buildingName: row.building_name,
      resolutionNumber: row.resolution_number,
      resolutionTitle: row.resolution_title,
      resolutionBody: row.resolution_body,
      resolutionStatus: row.resolution_status,
      ownerFullName: row.owner_full_name,
      ownerUnitNumbers: row.owner_unit_numbers,
      ownerShareBps: row.owner_share_bps,
      ownVoteChoice: row.own_vote_choice,
      ownVotedAt: row.own_voted_at,
      castAction: `/api/vote/${encodeURIComponent(token)}`,
    };
  }
}

const pendingChoice = parseChoice(Astro.url.searchParams.get("wybor"));

/**
 * Both vote columns are required for the receipt, not just the choice: they come from one
 * left-joined row whose `created_at` is `not null`, so they are set together or not at all.
 * Requiring both means a half-populated row falls through to the buttons rather than
 * rendering a receipt with no date — and pressing them again is harmless, since cast_vote
 * returns the vote already stored.
 */
let state: VoteState = { kind: "neutral" };

/**
 * Whether the uchwała has been settled. Ordered BEFORE `pendingChoice` below, so a link opened
 * on a decided resolution — with or without a stale `?wybor` in it — never reaches the confirm
 * screen. Before S-05 this page branched only on whether the reader had voted, which was right
 * while `open` was the only status a resolved token could carry; it is not right now.
 *
 * The receipt still wins over everything: someone who voted sees their own vote first,
 * whatever became of the uchwała afterwards.
 */
const isDecided = view !== null && isResolutionDecided(view.resolutionStatus);

if (view) {
  if (view.ownVoteChoice && view.ownVotedAt) {
    state = { kind: "receipt", choice: view.ownVoteChoice, votedAt: view.ownVotedAt };
  } else if (isDecided) {
    state = { kind: "closed" };
  } else if (pendingChoice) {
    state = { kind: "confirm", choice: pendingChoice };
  } else {
    state = { kind: "buttons" };
  }
}

/**
 * One sentence for the settled uchwała, shown to whoever holds a link to it — voter or not.
 * This is a fact about their own community, not about any other owner's vote: the visibility
 * contract is untouched, resolve_voting_link was not widened, and how anyone else voted
 * remains S-06's question.
 */
const outcomeText =
  view === null || !isDecided
    ? null
    : view.resolutionStatus === "passed"
      ? "Uchwała została podjęta — udziały „za” przekroczyły połowę wszystkich udziałów w budynku."
      : "Uchwała upadła — udziały „przeciw” przekroczyły połowę wszystkich udziałów w budynku.";

// Rendered only inside the resolved branch (property 1). The endpoint sets it when the read
// path worked and the write did not, which is the one failure that can be named here.
const error = Astro.url.searchParams.get("error");

// Both choices share one class, deliberately: a Za styled more invitingly than a Przeciw is
// the interface putting a thumb on a vote. Neither is the primary button — the primary is the
// confirm on the next screen, which is the press that actually writes.
const choiceButtonClass =
  "w-full rounded-md border border-input bg-card px-4 py-3.5 text-lg font-semibold text-foreground transition-colors hover:border-ring hover:bg-accent";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{view ? `Uchwała ${view.resolutionNumber}` : "Głosowanie"}</title>
  </head>
  <body class="bg-background text-foreground min-h-screen">
    {
      /* No topbar and no AppShell here — both carry links, and this page must have none: a
        click on one would put the voting token into a Referer header on its way off-site.
        The wordmark below is plain text for exactly that reason; do not make it a link. */
    }
    <div class="mx-auto w-full max-w-2xl px-4 py-10 sm:py-14">
      <p class="text-muted-foreground mb-6 text-sm font-semibold tracking-tight">EstateManager</p>

      <div class:list={CARD_PADDED}>
        {
          view ? (
            <>
              <p class:list={MUTED_TEXT}>{view.buildingName}</p>
              <h1 class:list={["mt-1", PAGE_TITLE]}>Uchwała {view.resolutionNumber}</h1>
              <h2 class:list={["mt-2", SECTION_TITLE]}>{view.resolutionTitle}</h2>

              {/* set:text rather than children: whitespace-pre-wrap would otherwise render
                  the template's own indentation as part of the resolution. */}
              <p
                class="text-foreground mt-4 text-sm leading-relaxed whitespace-pre-wrap"
                set:text={view.resolutionBody}
              />

              <div class:list={[PANEL, "mt-8"]}>
                <p class:list={MUTED_TEXT}>{state.kind === "receipt" ? "Głos oddany przez" : "Głosujesz jako"}</p>
                <p class="text-foreground mt-1 font-medium">{view.ownerFullName}</p>
                <p class:list={["mt-1", MUTED_TEXT]}>
                  {view.ownerUnitNumbers.length === 1 ? "Lokal" : "Lokale"}: {view.ownerUnitNumbers.join(", ")} · Udział
                  w głosowaniu:{" "}
                  <span class="text-foreground font-semibold tabular-nums">{formatShareBps(view.ownerShareBps)}</span>
                </p>
              </div>

              {error && (
                <p class:list={[ALERT_ERROR, "mt-6"]} role="alert">
                  {error}
                </p>
              )}

              {/* The outcome, for anyone holding a link to a settled uchwała — before the
                  receipt, because what happened to the uchwała is the headline and how this
                  reader voted is the footnote. Rendered from resolution_status, which
                  resolve_voting_link already returned; nothing was added to that function's
                  return list, so the visibility contract is exactly as narrow as it was. */}
              {outcomeText && (
                <div
                  class:list={[
                    ALERT,
                    "mt-6",
                    view.resolutionStatus === "passed" ? ALERT_TONES.success : ALERT_TONES.danger,
                  ]}
                >
                  <h2 class="text-base font-semibold">
                    {view.resolutionStatus === "passed" ? "Uchwała została podjęta" : "Uchwała upadła"}
                  </h2>
                  <p class="mt-2">{outcomeText}</p>
                  <p class="mt-2 opacity-80">Głosowanie nad tą uchwałą zostało zakończone.</p>
                </div>
              )}

              {/* Settled, and this reader never voted. No buttons, because pressing one would
                  post to cast_vote, be refused for want of an open resolution, and redirect
                  back here with nothing said — the neutral answer is correct at the endpoint
                  and would be an unexplained loop on the screen. The fix belongs here, not
                  there: /api/vote/[token] must go on answering a late vote exactly as it
                  answers an unknown token. */}
              {state.kind === "closed" && (
                <p class:list={["mt-4", MUTED_TEXT]}>
                  Pod tym linkiem nie oddano głosu, a głosowanie jest już zamknięte — nie można go teraz oddać.
                </p>
              )}

              {state.kind === "receipt" && (
                <div class:list={[ALERT, ALERT_TONES.success, "mt-6"]}>
                  <h2 class="text-base font-semibold">Twój głos został zapisany</h2>
                  <p class="mt-2">
                    Zagłosowano: <span class="text-lg font-semibold">{choiceLabel(state.choice)}</span>
                  </p>
                  <p class="mt-1 opacity-80">Zapisano {formatResolutionDate(state.votedAt)}</p>
                  <p class="mt-3">
                    Głosu nie można zmienić ani wycofać. Zachowaj ten link — pod nim zawsze zobaczysz to potwierdzenie
                    {isDecided ? " oraz wynik głosowania." : "."}
                  </p>
                </div>
              )}

              {state.kind === "confirm" && (
                <div class:list={[ALERT, ALERT_TONES.warning, "mt-6"]}>
                  <h2 class="text-base font-semibold">Potwierdź swój głos</h2>
                  <p class="mt-2">
                    Zamierzasz zagłosować: <span class="text-lg font-semibold">{choiceLabel(state.choice)}</span>
                  </p>
                  <p class="mt-3">Głos jest ostateczny. Po zapisaniu nie można go zmienić ani wycofać.</p>

                  <form method="POST" action={view.castAction} class="mt-4">
                    <input type="hidden" name="choice" value={state.choice} />
                    <button type="submit" class:list={BUTTON_PRIMARY_BLOCK}>
                      Oddaję głos — potwierdzam
                    </button>
                  </form>

                  {/* No action, so it submits to the current URL with an empty form data set:
                      that drops ?wybor and lands back on the buttons. An anchor would do the
                      same thing at the cost of putting the token in an href (property 2). */}
                  <form method="get" class="mt-3">
                    <button type="submit" class:list={BUTTON_SECONDARY_BLOCK}>
                      Wróć do wyboru
                    </button>
                  </form>
                </div>
              )}

              {state.kind === "buttons" && (
                <div class="mt-6">
                  <p class="text-foreground text-sm">
                    Zagłosuj nad uchwałą. Twój głos waży tyle, ile wynosi udział Twoich lokali — poprosimy jeszcze o
                    potwierdzenie, zanim go zapiszemy.
                  </p>

                  {/* No action: submits to the current URL, so ?wybor is the only thing that
                      changes and the token never enters this markup. */}
                  <form method="get" class="mt-4 grid gap-3 sm:grid-cols-2">
                    <button type="submit" name="wybor" value="za" class:list={choiceButtonClass}>
                      Za
                    </button>
                    <button type="submit" name="wybor" value="przeciw" class:list={choiceButtonClass}>
                      Przeciw
                    </button>
                  </form>
                </div>
              )}
            </>
          ) : (
            <>
              <h1 class:list={PAGE_TITLE}>Nie znaleziono głosowania</h1>
              <p class="text-muted-foreground mt-3 text-sm">
                Ten link jest niepoprawny albo głosowanie nie zostało jeszcze uruchomione. Skontaktuj się z zarządcą
                swojej wspólnoty.
              </p>
            </>
          )
        }
      </div>
    </div>
  </body>
</html>
