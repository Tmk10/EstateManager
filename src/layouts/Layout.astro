---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { getMissingConfigs } from "@/lib/config-status";

// The document. Chrome above the content — the topbar, the page frame — belongs to
// AppShell.astro, which wraps this; a screen that wants the document without the chrome
// (there is one: /vote/<token>, and its page comment says why) uses neither.

interface Props {
  title?: string;
}

const { title = "EstateManager" } = Astro.props;
const missingConfigs = getMissingConfigs();
---

<!doctype html>
{
  /* `pl`, not `en`: every word this application renders is Polish. A screen reader takes the
    document language as its pronunciation rule, so `en` had it reading Polish names with
    English phonetics. */
}
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground min-h-screen">
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong class="font-semibold">Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>
