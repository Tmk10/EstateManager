---
import { NAV_LINK, SHELL_CONTAINER } from "@/lib/ui";

// The application's one persistent bar: what the product is called, who you are, and the way
// out. It is deliberately not where you navigate — that is the module rail in
// `src/components/SideNav.astro`, and this bar carried a copy of the same two links until the
// rail arrived on 2026-08-05. Two lists of identical destinations, one above the other, is how
// an interface starts to feel larger than the product behind it.
//
// The wordmark stays a link, because it is the shortest way back to the panel from anywhere.

const { user } = Astro.locals;
---

<header class="border-border bg-card/95 supports-[backdrop-filter]:bg-card/80 sticky top-0 z-20 border-b backdrop-blur">
  <div class:list={[SHELL_CONTAINER, "flex h-14 items-center gap-6"]}>
    <a
      href={user ? "/dashboard" : "/"}
      class="text-foreground hover:text-primary text-sm font-semibold tracking-tight transition-colors"
    >
      EstateManager
    </a>

    <div class="ml-auto flex items-center gap-4 text-sm">
      {
        user ? (
          <>
            {/* Hidden on a phone: the address is context, not a control, and at this width the
                sign-out button is what has to survive. */}
            <span class="text-muted-foreground hidden sm:inline">{user.email}</span>
            <form method="POST" action="/api/auth/signout">
              <button type="submit" class:list={NAV_LINK}>
                Wyloguj
              </button>
            </form>
          </>
        ) : (
          <a href="/auth/signin" class="text-primary hover:text-primary/80 text-sm font-medium transition-colors">
            Zaloguj się
          </a>
        )
      }
    </div>
  </div>
</header>
