---
import { BUILDING_MODULES, buildingModuleHref } from "@/lib/building-modules";

// The building context every level-2 screen carries. The roadmap (`S-09`) names this — not the
// cards — as the substance of the slice: navigation has to hold the state "I am in building X",
// otherwise the second level falls apart into loose screens that happen to share a URL prefix.
//
// `activeModule` is omitted on the module index itself: there the cards are the navigation, and
// a strip repeating them above would be the same list twice.

interface Props {
  building: { id: string; name: string; city: string; street: string };
  activeModule?: string;
}

const { building, activeModule } = Astro.props;
---

<div class="mb-6">
  <nav aria-label="Ścieżka nawigacji" class="mb-3 text-sm text-blue-100/50">
    <a href="/buildings" class="underline-offset-4 transition-colors hover:text-blue-100 hover:underline"> Budynki </a>
    <span aria-hidden="true" class="px-1.5">/</span>
    {
      activeModule ? (
        <a
          href={`/buildings/${building.id}`}
          class="underline-offset-4 transition-colors hover:text-blue-100 hover:underline"
        >
          {building.name}
        </a>
      ) : (
        <span class="text-blue-100/70">{building.name}</span>
      )
    }
  </nav>

  <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
    {building.name}
  </h1>
  <p class="mt-1 text-sm text-blue-100/60">
    {building.street}, {building.city}
  </p>

  {
    activeModule && (
      <nav aria-label="Moduły budynku" class="mt-5 flex flex-wrap gap-2">
        {BUILDING_MODULES.map((module) => {
          const isActive = module.id === activeModule;
          return (
            <a
              href={buildingModuleHref(building.id, module)}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "rounded-lg border px-3 py-1.5 text-sm transition-colors",
                isActive
                  ? "border-purple-400/50 bg-purple-500/20 font-medium text-white"
                  : "border-white/10 bg-white/5 text-blue-100/70 hover:bg-white/10 hover:text-white",
              ]}
            >
              {module.label}
            </a>
          );
        })}
      </nav>
    )
  }
</div>
