---
import { BUILDING_MODULES, buildingModuleHref } from "@/lib/building-modules";
import { PAGE_TITLE, MUTED_TEXT, NAV_LINK } from "@/lib/ui";

// The building context every level-2 screen carries. The roadmap (`S-09`) names this — not the
// cards — as the substance of the slice: navigation has to hold the state "I am in building X",
// otherwise the second level falls apart into loose screens that happen to share a URL prefix.
//
// `activeModule` is omitted on the module index itself: there the cards are the navigation, and
// a strip repeating them above would be the same list twice.
//
// The strip is drawn as underlined tabs rather than as pills. Tabs read as "these are the
// sections of the thing named above" and pills read as "these are buttons"; the distinction
// matters here because the building's name sits directly above them and is what they belong to.

interface Props {
  building: { id: string; name: string; city: string; street: string };
  activeModule?: string;
}

const { building, activeModule } = Astro.props;
---

<div class="mb-8">
  <nav aria-label="Ścieżka nawigacji" class="mb-3 flex items-center gap-1.5 text-sm">
    <a href="/buildings" class:list={NAV_LINK}>Budynki</a>
    <span aria-hidden="true" class="text-muted-foreground/50">/</span>
    {
      activeModule ? (
        <a href={`/buildings/${building.id}`} class:list={NAV_LINK}>
          {building.name}
        </a>
      ) : (
        <span class="text-foreground">{building.name}</span>
      )
    }
  </nav>

  <h1 class:list={PAGE_TITLE}>{building.name}</h1>
  <p class:list={["mt-1", MUTED_TEXT]}>
    {building.street}, {building.city}
  </p>

  {
    activeModule && (
      <nav aria-label="Moduły budynku" class="border-border mt-6 flex flex-wrap gap-6 border-b">
        {BUILDING_MODULES.map((module) => {
          const isActive = module.id === activeModule;
          return (
            <a
              href={buildingModuleHref(building.id, module)}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "-mb-px border-b-2 pb-2.5 text-sm transition-colors",
                isActive
                  ? "border-primary text-primary font-medium"
                  : "text-muted-foreground hover:border-border hover:text-foreground border-transparent",
              ]}
            >
              {module.label}
            </a>
          );
        })}
      </nav>
    )
  }
</div>
