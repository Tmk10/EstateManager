---
import { PAGE_TITLE, MUTED_TEXT, NAV_LINK } from "@/lib/ui";

// The building context every level-2 screen carries. The roadmap (`S-09`) names this — not the
// cards — as the substance of the slice: navigation has to hold the state "I am in building X",
// otherwise the second level falls apart into loose screens that happen to share a URL prefix.
//
// It used to carry the building's modules as a strip of tabs under the address. The strip is
// gone as of 2026-08-05: the modules are in the rail on the left (`src/components/SideNav.astro`)
// and the rail marks the current one, so the tabs would have been the same list a second time, a
// few centimetres away. What is left is what the rail cannot say — *which* building this is, and
// the way back up to the list of them.

interface Props {
  building: { id: string; name: string; city: string; street: string };
  /**
   * Whether this screen sits inside a module of the building rather than on its overview. It
   * decides one thing only: whether the building's own name in the breadcrumb is a link back to
   * that overview, or the end of the trail.
   */
  inModule?: boolean;
}

const { building, inModule = false } = Astro.props;
---

<div class="mb-8">
  <nav aria-label="Ścieżka nawigacji" class="mb-3 flex items-center gap-1.5 text-sm">
    <a href="/buildings" class:list={NAV_LINK}>Budynki</a>
    <span aria-hidden="true" class="text-muted-foreground/50">/</span>
    {
      inModule ? (
        <a href={`/buildings/${building.id}`} class:list={NAV_LINK}>
          {building.name}
        </a>
      ) : (
        <span class="text-foreground">{building.name}</span>
      )
    }
  </nav>

  <h1 class:list={PAGE_TITLE}>{building.name}</h1>
  <p class:list={["mt-1", MUTED_TEXT]}>
    {building.street}, {building.city}
  </p>
</div>
