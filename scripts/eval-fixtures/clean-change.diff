+import { describe, expect, it } from "vitest";
+import { formatSharePercentage } from "./format-bps";
+
+describe("formatSharePercentage", () => {
+  it("formats whole basis points with a Polish decimal comma", () => {
+    expect(formatSharePercentage(4250)).toBe("42,50%");
+  });
+
+  it("formats the full building as 100,00%", () => {
+    expect(formatSharePercentage(10000)).toBe("100,00%");
+  });
+});
